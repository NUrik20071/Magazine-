# Copy these values into your hosting provider's environment settings.
# Do not commit real secret values to Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=10000
BASE_PATH=/
NODE_ENV=production
# Clerk Dashboard -> API keys
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
# Same publishable key is embedded into the frontend at build time
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# Comma-separated verified email addresses allowed into /admin
ADMIN_EMAILS=you@example.com
